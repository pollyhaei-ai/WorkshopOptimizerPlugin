<Project Sdk="Dalamud.NET.Sdk/13.1.0">
    <PropertyGroup>
        <Authors>HappySprite</Authors>
        <Version>0.3.2-tw</Version>
        <AssemblyVersion>0.3.2.0</AssemblyVersion>
        <FileVersion>0.3.2.0</FileVersion>
        <InformationalVersion>0.3.2-tw</InformationalVersion>
        <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
        <TargetFramework>net9.0-windows7.0</TargetFramework>
        <AssemblyName>WorkshopOptimizerPlugin</AssemblyName>
        <Description>台服開拓無人島工坊生產計畫（yanmucorp Dalamud API 13）。上游 HappySprite / belzaru17 WorkshopOptimizerPlugin。</Description>
        <Copyright>Copyright © HappySprite 2022-2025</Copyright>
        <PackageProjectUrl>https://github.com/pollyhaei-ai/WorkshopOptimizerPlugin</PackageProjectUrl>
        <RepositoryUrl>https://github.com/belzaru17/WorkshopOptimizerPlugin</RepositoryUrl>
    </PropertyGroup>

    <ItemGroup>
        <Content Include="Resources\**" DestinationFolder="Resources\$(RecursiveDir)" CopyToOutputDirectory="Always" />
        <Content Include="..\Images\icon.png" Link="images\icon.png" CopyToOutputDirectory="PreserveNewest" />
    </ItemGroup>

    <ItemGroup>
        <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
            <_Parameter1>WorkshopOptimizerPluginTest</_Parameter1>
        </AssemblyAttribute>
    </ItemGroup>
</Project>
